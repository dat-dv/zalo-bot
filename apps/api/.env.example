# ============================================================
# 1. HỆ THỐNG & HTTP API
# ============================================================
PORT=3000
APP_URL=https://zalobot.example.com
WEB_ORIGIN=https://zalobot.example.com
CORS_ALLOW_ALL=false
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# ============================================================
# 2. CƠ SỞ DỮ LIỆU & CACHE (PostgreSQL & Redis)
# ============================================================
DATABASE_URL=postgresql://zalobot:replace-with-a-long-random-password@localhost:5432/zalobot
DATABASE_SSL=false
TYPEORM_SYNCHRONIZE=false
REDIS_URL=redis://localhost:6379

POSTGRES_DB=zalobot
POSTGRES_USER=zalobot
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ============================================================
# 3. ZALO BOT & WEBHOOK
# ============================================================
ZALO_BOT_TOKEN=replace-with-your-zalo-bot-token
ZALO_WEBHOOK_URL=https://bot.datintech.site/webhook
ZALO_ALLOWED_USER_IDS=

# ============================================================
# 5. GOOGLE OAUTH & BẢO MẬT (JWT / ENCRYPTION)
# ============================================================
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
DASHBOARD_ACCESS_TOKEN_SECRET=replace-with-a-64-character-random-secret
DASHBOARD_REFRESH_TOKEN_SECRET=replace-with-a-different-64-character-random-secret

# ============================================================
# 6. CẤU HÌNH LLM (GEMINI / OPENAI / QWEN)
# ============================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Cấu hình Qwen qua OpenAI-compatible endpoint
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:14b
QWEN_API_KEY=

# Trí nhớ hội thoại ZCA: lưu tin của các kênh đang listen vào bảng zca_messages để bot trả lời câu hỏi về chuyện cũ
CHAT_MEMORY_ENABLED=false
# Số tin gần nhất đưa vào prompt để hiểu câu nối tiếp (0 = tắt)
CHAT_MEMORY_CONTEXT_WINDOW=10
# Số tin khớp nhất lấy ra mỗi lần tìm (mỗi tin kèm vài tin xung quanh, tối đa 80 dòng gửi LLM)
CHAT_MEMORY_SEARCH_LIMIT=15
# LLM OpenAI-compatible riêng để trả lời câu hỏi trí nhớ (vd 9router). Để trống = dùng LLM_PROVIDER
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=
MEMORY_LLM_API_KEY=
