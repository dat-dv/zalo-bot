# ============================================================
# 1. HỆ THỐNG & HTTP API
# ============================================================
PORT=3000
APP_URL=https://zalobot.example.com
WEB_ORIGIN=https://zalobot.example.com
CORS_ALLOW_ALL=false
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# ============================================================
# 2. CƠ SỞ DỮ LIỆU & CACHE (PostgreSQL & Redis)
# ============================================================
DATABASE_URL=postgresql://zalobot:replace-with-a-long-random-password@localhost:5432/zalobot
DATABASE_SSL=false
TYPEORM_SYNCHRONIZE=false
REDIS_URL=redis://localhost:6379

POSTGRES_DB=zalobot
POSTGRES_USER=zalobot
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ============================================================
# 3. ZALO BOT & WEBHOOK
# ============================================================
ZALO_BOT_TOKEN=replace-with-your-zalo-bot-token
ZALO_WEBHOOK_URL=https://bot.datintech.site/webhook
ZALO_ALLOWED_USER_IDS=

# ============================================================
# 5. GOOGLE OAUTH & BẢO MẬT (JWT / ENCRYPTION)
# ============================================================
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
DASHBOARD_ACCESS_TOKEN_SECRET=replace-with-a-64-character-random-secret
DASHBOARD_REFRESH_TOKEN_SECRET=replace-with-a-different-64-character-random-secret

# ============================================================
# 6. CẤU HÌNH LLM (GEMINI / OPENAI / QWEN)
# ============================================================
LLM_PROVIDER=gemini
# Chuỗi LLM: thử LLM_PROVIDER trước, lỗi/timeout/rỗng thì thử lần lượt các provider ở đây (vd: gemini)
LLM_FALLBACK_PROVIDERS=
# Timeout mỗi lời gọi LLM (ms)
LLM_TIMEOUT_MS=30000
# Provider "router": LLM router OpenAI-compatible (vd 9router). Dùng với LLM_PROVIDER=router
ROUTER_BASE_URL=
ROUTER_MODEL=
ROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Cấu hình Qwen qua OpenAI-compatible endpoint
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:14b
QWEN_API_KEY=
