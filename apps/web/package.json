{
  "name": "@zalobot/web",
  "version": "1.0.81",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${FE_PORT:-5173}",
    "build": "next build",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{app,src}/**/*.{ts,tsx,css}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"{app,src}/**/*.{ts,tsx,css}\" \"*.{js,ts,json}\"",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --test $(find src -name '*.spec.ts' -print)",
    "start": "next dev"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@zalobot/contracts": "file:../../packages/contracts",
    "axios": "^1.8.4",
    "next": "^16.3.2",
    "next-intl": "^4.13.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-scan": "^0.5.7",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.35.1"
  }
}
