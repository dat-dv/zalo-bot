# ==============================================================================
#                      DỰ ÁN TRỢ LÝ ẢO ZALO (MONOREPO)
#                  FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.ENV)
# ==============================================================================

# ==============================================================================
#                           PHẦN 1: BACKEND (API & ZALO BOT)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1.1. Hệ thống & Mạng (Gateway, Ports, CORS, Timezone)
# ------------------------------------------------------------------------------
NGINX_PORT=3000
GATEWAY_PORT=3000
BE_PORT=3005
FE_PORT=5173
PORT=3000
APP_URL=https://zalobot.example.com
WEB_ORIGIN=https://zalobot.example.com
CORS_ALLOW_ALL=false
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# 1.2. Cơ sở dữ liệu & Bộ nhớ đệm (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://zalobot:replace-with-a-long-random-password@localhost:5432/zalobot
DATABASE_SSL=false
TYPEORM_SYNCHRONIZE=false
REDIS_URL=redis://localhost:6379

POSTGRES_DB=zalobot
POSTGRES_USER=zalobot
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ------------------------------------------------------------------------------
# 1.3. Cấu hình Zalo Bot & Webhook
# ------------------------------------------------------------------------------
BOT_NAME=Bot Finance Assistant
ZALO_BOT_TOKEN=replace-with-your-zalo-bot-token
ZALO_WEBHOOK_URL=https://bot.datintech.site/webhook
ZALO_WEBHOOK_SECRET_TOKEN=
# Tự động gửi thông báo qua Zalo khi bot khởi động / deploy thành công (mặc định bật ở production, đặt true để bật khi test)
NOTIFY_ON_STARTUP=true
APP_VERSION=v1.0.0

# ------------------------------------------------------------------------------
# 1.4. Cấu hình ZCA (Zalo Client API / zca-js qua Proxy)
# ------------------------------------------------------------------------------
# Proxy URL định tuyến cho ZCA (hỗ trợ http và https proxy có auth)
ZCA_PROXY_URL=http://user:pass@host:port
# Thông tin xác thực Zalo cá nhân (hoặc chạy npm run zca:login để lấy tự động qua QR)
ZCA_IMEI=
ZCA_COOKIE=
ZCA_USER_AGENT=
# Tự động đăng nhập ZCA khi backend khởi động (nếu đã cấu hình IMEI và COOKIE)
ZCA_AUTO_LOGIN=false
# Cho phép bot lắng nghe và phản hồi tin nhắn do chính tài khoản Zalo của bot gửi (bật true khi test bot bằng nick bot)
ZCA_SELF_LISTEN=true
ZCA_CHECK_UPDATE=false
ZCA_LOGGING=false

# ------------------------------------------------------------------------------
# 1.5. Google OAuth & Bảo mật (Mã hóa dữ liệu & JWT Dashboard)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
DASHBOARD_ACCESS_TOKEN_SECRET=replace-with-64-random-characters
DASHBOARD_REFRESH_TOKEN_SECRET=replace-with-another-64-random-characters

# ------------------------------------------------------------------------------
# 1.6. Cấu hình LLM / AI Models (Gemini / OpenAI / Qwen)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:14b
QWEN_API_KEY=



# ==============================================================================
#                      PHẦN 2: FRONTEND (WEB DASHBOARD - NEXT.JS)
# ==============================================================================

# URL API của Backend mà trình duyệt và Next.js gọi tới
NEXT_PUBLIC_API_URL=https://zalobot.example.com

# Port chạy container Web (dùng cho Docker Compose)
WEB_PORT=3001
