# ==============================================================================
#                      DỰ ÁN TRỢ LÝ ẢO ZALO (MONOREPO)
#                  FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.ENV)
# ==============================================================================

# ==============================================================================
#                           PHẦN 1: BACKEND (API & ZALO BOT)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1.1. Hệ thống & Mạng (HTTP Server, CORS, Timezone)
# ------------------------------------------------------------------------------
PORT=3000
APP_URL=https://zalobot.example.com
WEB_ORIGIN=https://zalobot.example.com
CORS_ALLOW_ALL=false
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# 1.2. Cơ sở dữ liệu & Bộ nhớ đệm (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://zalobot:replace-with-a-long-random-password@localhost:5432/zalobot
DATABASE_SSL=false
TYPEORM_SYNCHRONIZE=false
REDIS_URL=redis://localhost:6379

POSTGRES_DB=zalobot
POSTGRES_USER=zalobot
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ------------------------------------------------------------------------------
# 1.3. Cấu hình Zalo Bot & Webhook
# ------------------------------------------------------------------------------
ZALO_BOT_TOKEN=replace-with-your-zalo-bot-token
ZALO_WEBHOOK_URL=https://bot.datintech.site/webhook
ZALO_ADMIN_ID=replace-with-admin-zalo-user-id
ZALO_ALLOWED_USER_IDS=


# ------------------------------------------------------------------------------
# 1.5. Google OAuth & Bảo mật (Mã hóa dữ liệu & JWT Dashboard)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
DASHBOARD_ACCESS_TOKEN_SECRET=replace-with-64-random-characters
DASHBOARD_REFRESH_TOKEN_SECRET=replace-with-another-64-random-characters

# ------------------------------------------------------------------------------
# 1.6. Cấu hình LLM / AI Models (Gemini / OpenAI / Qwen 14B / Ollama)
# ------------------------------------------------------------------------------
LLM_PROVIDER=qwen
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:14b
QWEN_API_KEY=



# ==============================================================================
#                      PHẦN 2: FRONTEND (WEB DASHBOARD - NEXT.JS)
# ==============================================================================

# URL API của Backend mà trình duyệt và Next.js gọi tới
NEXT_PUBLIC_API_URL=https://zalobot.example.com

# Port chạy container Web (dùng cho Docker Compose)
WEB_PORT=3001
