# ==============================================================================
#                 DỰ ÁN TRỢ LÝ ẢO ZALO — FILE MẪU BIẾN MÔI TRƯỜNG
# ==============================================================================
# Chỉ liệt kê biến cần tự khai báo. Các biến khác đã có mặc định trong code
# (xem .agents/docs/global/environment-guard.md), chỉ thêm khi muốn đổi.

# ------------------------------------------------------------------------------
# Hệ thống & Mạng
# ------------------------------------------------------------------------------
# Domain công khai. WEB_ORIGIN và API của web suy ra từ đây.
APP_URL=https://zalobot.example.com
# Cổng Nginx gateway / web container (mặc định 3000 khi dev, 3009 trong docker-compose.yml)
NGINX_PORT=3000
# Cổng API và timezone. docker-compose.yml tham chiếu 2 biến này nên Coolify luôn hiện chúng.
BE_PORT=3005
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# Tuỳ chọn, chỉ khi dev: mở CORS cho mọi origin. Production để trống (web và API cùng domain).
# CORS_ALLOW_ALL=true

# ------------------------------------------------------------------------------
# PostgreSQL & Redis
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://zalobot:replace-with-a-long-random-password@localhost:5432/zalobot
REDIS_URL=redis://localhost:6379
# docker-compose.yml cố định DATABASE_URL, REDIS_URL và 3 biến dưới (dùng postgres:5432,
# redis:6379, /app/data) nên Coolify luôn hiện chúng. Giá trị ở đây là cho máy dev.
DATABASE_SSL=false
DATA_DIR=./data
TYPEORM_SYNCHRONIZE=false
# Container Postgres/Redis trong Docker Compose (phải khớp với DATABASE_URL, REDIS_URL).
# docker-compose.yml cố định POSTGRES_DB/POSTGRES_USER là zalobot; Coolify luôn hiện các biến này.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=zalobot
POSTGRES_USER=zalobot
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Zalo (ZCA — tài khoản Zalo cá nhân của bot, đăng nhập bằng QR trên dashboard)
# ------------------------------------------------------------------------------
BOT_NAME=Bot Finance Assistant
# Tuỳ chọn, chỉ khi dev: bật khi test bằng chính nick Zalo của bot. Production để trống.
# ZCA_SELF_LISTEN=true
# Tuỳ chọn: proxy cho ZCA, dạng http://user:pass@host:port
# ZCA_PROXY_URL=

# ------------------------------------------------------------------------------
# Google OAuth & Bảo mật
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# openssl rand -hex 32
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
DASHBOARD_ACCESS_TOKEN_SECRET=replace-with-64-random-characters
DASHBOARD_REFRESH_TOKEN_SECRET=replace-with-another-64-random-characters
# Tuỳ chọn: mã đăng nhập dashboard cố định (8 ký tự 0-9, A-Z trừ I L O U; dấu gạch tuỳ ý),
# đăng nhập thành admin "Chủ hệ thống". Không hết hạn: đừng commit mã thật, đổi mã = sửa env + restart.
# Giới hạn thử sai: 10 lần/IP và 200 lần toàn hệ thống mỗi 15 phút. Để trống = tắt.
DASHBOARD_LOGIN_CODE=

# ------------------------------------------------------------------------------
# LLM
# ------------------------------------------------------------------------------
# gemini | openai | qwen | router. Lỗi/timeout thì thử lần lượt LLM_FALLBACK_PROVIDERS.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Tuỳ chọn: chuỗi provider dự phòng, phân cách bằng dấu phẩy.
# LLM_FALLBACK_PROVIDERS=gemini
# Provider khác (chỉ khai báo khi dùng): ROUTER_BASE_URL/ROUTER_MODEL/ROUTER_API_KEY,
# OPENAI_API_KEY (+ OPENAI_MODEL, OPENAI_BASE_URL), QWEN_BASE_URL/QWEN_MODEL/QWEN_API_KEY.
