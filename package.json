{
  "name": "zalobot-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build --workspace @zalobot/contracts",
    "dev": "concurrently -k --names api,web --prefix-colors blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "kill:ports": "lsof -ti:3005,5173,3000 | xargs kill -9 2>/dev/null || true",
    "docker:local": "docker compose -f docker-compose.local.yml up -d",
    "docker:local:down": "docker compose -f docker-compose.local.yml down",
    "dev:api": "npm run start:dev --workspace @zalobot/api",
    "dev:web": "npm run dev --workspace @zalobot/web",
    "build": "npm run build --workspace @zalobot/contracts && npm run build --workspace @zalobot/api && npm run build --workspace @zalobot/web",
    "build:api": "npm run build --workspace @zalobot/api",
    "build:web": "npm run build --workspace @zalobot/web",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "lint": "npm run lint:check --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start:api": "npm run start:prod --workspace @zalobot/api",
    "zalo:webhook:status": "npm run zalo:webhook:status --workspace @zalobot/api",
    "zalo:webhook:set": "npm run zalo:webhook:set --workspace @zalobot/api",
    "zalo:webhook:test": "npm run zalo:webhook:test --workspace @zalobot/api",
    "zalo:webhook:delete": "npm run zalo:webhook:delete --workspace @zalobot/api",
    "tunnel": "bash scripts/tunnel.sh",
    "tunnel:bg": "bash scripts/tunnel.sh bg",
    "tunnel:stop": "bash scripts/tunnel.sh stop",
    "zalo:tunnel": "bash scripts/tunnel.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
