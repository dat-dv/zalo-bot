server {
    listen 80;
    server_name _;

    # Tắt redirect kèm port nội bộ 80 của Nginx
    absolute_redirect off;
    port_in_redirect off;

    # 1. API routes -> Forward tới Backend NestJS ngoài máy host
    location /api/ {
        proxy_pass http://host.docker.internal:${BE_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 2. Zalo Webhook -> Forward tới Backend NestJS ngoài máy host
    location /webhook {
        proxy_pass http://host.docker.internal:${BE_PORT}/webhook;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /zalo/ {
        proxy_pass http://host.docker.internal:${BE_PORT}/zalo/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Google OAuth callback -> Forward tới Backend NestJS ngoài máy host
    location /oauth2callback {
        proxy_pass http://host.docker.internal:${BE_PORT}/oauth2callback;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 4. Frontend Next.js (Dashboard + Next.js Fast Refresh HMR WebSocket) ngoài máy host
    location / {
        proxy_pass http://host.docker.internal:${FE_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
