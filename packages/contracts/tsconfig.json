{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuild/contracts.tsbuildinfo",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
